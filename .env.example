# Copy to .env and fill in. Never commit the real .env.

# ── Core ──────────────────────────────────────────────────────────────────────
# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.fly.dev,.onrender.com
CSRF_TRUSTED_ORIGINS=https://handout-pay.vercel.app
CORS_ALLOWED_ORIGINS=https://handout-pay.vercel.app,http://localhost:5173
TIME_ZONE=Africa/Accra
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset to fall back to local sqlite. Use Postgres in production —
# a Fly machine's filesystem is ephemeral and sqlite data is lost on restart.
DATABASE_URL=postgres://user:password@host:5432/handout

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
# Required for course-rep signup. Rep registration is refused while this is blank.
REP_INVITE_CODE=

# ── Rate limits ───────────────────────────────────────────────────────────────
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PAYMENT=10/hour
THROTTLE_CALLBACK=120/min

# ── MTN MoMo ──────────────────────────────────────────────────────────────────
MOMO_CONSUMER_KEY=
MOMO_CONSUMER_SECRET=
MOMO_SUBSCRIPTION_KEY=
MOMO_BASE_URL=https://api.mtn.com
MOMO_CURRENCY=GHS
MOMO_CALLBACK_URL=https://handout-b.fly.dev/api/payments/callback/
# Optional shared secret; when set, callbacks must send it as X-Callback-Token.
MOMO_CALLBACK_TOKEN=

# ── Celery ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Notifications ─────────────────────────────────────────────────────────────
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=Handout
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@handout.local
